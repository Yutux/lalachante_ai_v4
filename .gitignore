# --- Secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Environnements virtuels ---
.venv/
venv/
env/

# --- Données (générées/téléchargées, trop volumineuses pour git) ---
data/raw/**
!data/raw/.gitkeep
!data/raw/spotify/PLACE_DATASET_HERE.txt

data/intermediate/**
!data/intermediate/.gitkeep

data/processed/**
!data/processed/.gitkeep

# embeddings IA (binaire volumineux, régénérable via build_context_embeddings.py)
data/processed/ai/*.npy
data/processed/ai/*.json

# --- Modèles téléchargés (sentence-transformers / HuggingFace cache local) ---
.cache/
*.cache/
models/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Streamlit ---
.streamlit/

# --- Éditeurs / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
